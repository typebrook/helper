#!/bin/bash
# Pipe a raw message from mutt; hand its Message-ID to an agent (claude or pi) with the mail skill.
# -a AGENT: claude (default) or pi
# -n: only print the command, do not run the agent
#
# Delivers a flagged "[Claim]" reply, so the issue is marked as taken and mutt
# shows it as soon as the pipe returns. A detached session (setsid -f) then:
#   1. runs the agent, logged into ~/.cache/mail-agent/<SESSION>.log
#   2. if it succeeds, deletes the claim and adds token usage to the agent's reply (usage.py)
#      on failure the claim stays, to show the resume command
set -euo pipefail
set -x

SKILL=$HOME/helper/skills/mail
LOGDIR=$HOME/.cache/mail-agent

agent_claude() { ${DRY:-} claude -p "/mail $1" --session-id "$2" --dangerously-skip-permissions --output-format json --model sonnet; }
agent_pi() { ${DRY:-} pi -p "/skill:mail $1" --skill "$SKILL" --session-id "$2" --mode json --model sonnet; }

# Command to resume a session, shown in the claim
resume_claude() { echo "claude --resume $1"; }
resume_pi() { echo "pi --session $1"; }

# Detached part, re-executed by the part below
if [ "${1:-}" = --run ]; then
  AGENT=$2 id=$3 session=$4 claim_id=$5
  cd "$SKILL"
  since=$(date +%s) status=0
  result=$(agent_$AGENT "$id" "$session") || status=$?
  echo "$result"
  [ $status -eq 0 ] || exit $status

  # Resolve the claim again: mail client or sync may have renamed it by flags
  if claim_msg=$(notmuch search --output files id:"$claim_id"); then
    rm -f "$claim_msg"
  fi
  ./usage.py "$id" --since "$since" <<<"$result"
  exit
fi

AGENT=claude DRY=
while getopts a:n opt; do
  case $opt in
    a) AGENT=$OPTARG ;;
    n) DRY=echo ;;
    *) exit 2 ;;
  esac
done
case $AGENT in
  claude|pi) ;;
  *) echo "mail-agent: unknown agent: $AGENT (claude or pi)" >&2; exit 2 ;;
esac

# Message-ID from stdin (handles folded headers and any capitalization)
id=$(sed -En '/^Message-I[dD]/{p;n;/^ /{p};q}' | tr -d '[<> \n]' | cut -d: -f2)
cat >/dev/null  # drain the rest, so mutt does not get SIGPIPE
[ -n "$id" ] || { echo "mail-agent: no Message-ID" >&2; exit 1; }

session=$(uuidgen)
[ -n "$DRY" ] && { agent_$AGENT "$id" "$session"; exit; }

# Claim: flagged reply in the original's Maildir; the flag moves from original to claim
cd "$SKILL"
orig=$(notmuch search --output files  id:"$id")
claim_id=$(date +%s.%N).claim@$(hostname)
mmime -r <<EOF | mdeliver -c -X F "$(dirname "$(dirname "$orig")")" >/dev/null
Subject: [Claim] $(resume_$AGENT "$session")  # on $(hostname)
Date: $(mdate)
Message-ID: <$claim_id>
In-Reply-To: <$id>

EOF
mflag -f "$orig" >/dev/null

log=$LOGDIR/$session.log
mkdir -p "$LOGDIR"
setsid -f "$(realpath "$0")" --run "$AGENT" "$id" "$session" "$claim_id" >"$log" 2>&1 </dev/null
