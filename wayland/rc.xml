          <action name="Raise" />
        </then>
        <none>
          <action name="Execute" command="uwsm-app -- obsidian" />
        </none>
      </action>
    </keybind>

    <!-- ############ Web apps migrated from Hyprland (applications.lua) ############ -->
    <keybind key="W-S-A-a"><action name="Execute" command="omarchy-launch-webapp 'https://grok.com'" /></keybind>
    <keybind key="W-S-c"><action name="Execute" command="omarchy-launch-webapp 'https://app.hey.com/calendar/weeks/'" /></keybind>
    <keybind key="W-S-A-e">
      <action name="Execute" command="omarchy-launch-webapp 'https://app.hey.com/messages/new?display=standalone&amp;new_window=true'" />
    </keybind>
    <keybind key="W-S-y"><action name="Execute" command="omarchy-launch-webapp 'https://youtube.com/'" /></keybind>
    <keybind key="W-S-A-x"><action name="Execute" command="omarchy-launch-webapp 'https://x.com/compose/post'" /></keybind>

    <!-- WhatsApp / Google Messages are "focus = true" in Hyprland -> run-or-raise -->
    <keybind key="W-S-A-g">
      <action name="ForEach">
        <query title="*WhatsApp*" />
        <then>
          <action name="Focus" />
          <action name="Raise" />
        </then>
        <none>
          <action name="Execute" command="omarchy-launch-webapp 'https://web.whatsapp.com/'" />
        </none>
      </action>
    </keybind>
    <keybind key="W-S-C-g">
      <action name="ForEach">
        <query title="*Google Messages*" />
        <then>
          <action name="Focus" />
          <action name="Raise" />
        </then>
        <none>
          <action name="Execute" command="omarchy-launch-webapp 'https://messages.google.com/web/conversations'" />
        </none>
      </action>
    </keybind>

    <keybind key="W-F1"><action name="Execute" command="ddcutil setvcp 60 0x01" /></keybind>

    <!-- Rofi -->
    <keybind key="A-F1">
      <action name="Execute" command="bash -c 'rofi -show drun -modes run -p &quot;$(acpi -b | grep -oP \&quot;[0-9]+%\&quot; | head -1)&quot;'" />
    </keybind>
    <keybind key="W-r"><action name="Execute" command="rofi -show run" /></keybind>
    <keybind key="W-p"><action name="Execute" command="~/helper/X11/rofi/rofi-pass" /></keybind>

    <!-- Network -->
    <keybind key="W-n"><action name="Execute" command="networkmanager_dmenu" /></keybind>
    <keybind key="W-S-n"><action name="Execute" command="nmcli device wifi connect pham password zzzzzzzz" /></keybind>
    <keybind key="W-i"><action name="Execute" command="nm-connection-editor" /></keybind>
    <keybind key="W-S-i">
      <action name="ForEach">
        <query title="Network Manager" />
        <then>
          <action name="Focus" />
          <action name="Raise" />
        </then>
        <none>
          <action name="Execute" command="foot -T 'Network Manager' -W 80x30 nmtui" />
        </none>
      </action>
    </keybind>
    <keybind key="W-b"><action name="Execute" command="blueman-manager" /></keybind>

    <!-- Audio -->
    <!--
    <keybind key="W-a"><action name="Execute" command="foot pulsemixer" /></keybind>
    -->
    <!-- Was the dead ob-music; now Hyprland's SUPER+SHIFT+A (ChatGPT web app) -->
    <keybind key="W-S-a"><action name="Execute" command="omarchy-launch-webapp 'https://chatgpt.com'" /></keybind>

    <!-- Mail -->
    <keybind key="W-m">
      <action name="ForEach">
        <query title="@Mutt" />
        <then>
          <action name="Focus" />
          <action name="Raise" />
        </then>
        <none>
          <action name="Execute" command="sh -c 'foot -T @Mutt -D ~/Downloads mutt; mbsync topo; notify-send -t 8000 &quot;mbsync $?&quot;'" />
        </none>
      </action>
    </keybind>

    <!-- Calendar: toggle -->
    <keybind key="W-v">
      <action name="ForEach">
        <query title="Calendar" />
        <then>
          <action name="Close" />
        </then>
        <none>
          <action name="Execute" command="foot --hold -T Calendar -o main.pad=100x70 -W 64x9 cal -3" />
        </none>
      </action>
    </keybind>

    <keybind key="W-S-g">
      <action name="Execute" command="foot --hold -T GPT -W 70x30 ~/helper/bin/gpt/gpt" />
    </keybind>
    <keybind key="W-g"><action name="Execute" command="/home/pham/helper/X11/openbox/scripts/ob-colorpicker" /></keybind>

    <keybind key="C-A-v"><action name="Execute" command="foot vim" /></keybind>
    <keybind key="C-A-n"><action name="Execute" command="foot vim" /></keybind>
    <keybind key="C-A-h"><action name="Execute" command="foot -T htop --maximized htop" /></keybind>
    <keybind key="C-A-b"><action name="Execute" command="foot bashtop" /></keybind>

    <!-- Lockscreen / power -->
    <keybind key="W-BackSpace"><action name="Execute" command="betterlockscreen --lock" /></keybind>
    <keybind key="W-x"><action name="Execute" command="systemctl suspend" /></keybind>
    <!-- Was the dead polybar-msg; now Hyprland's SUPER+SHIFT+P (Google Photos) -->
    <keybind key="W-S-p">
      <action name="ForEach">
        <query title="*Google Photos*" />
        <then>
          <action name="Focus" />
          <action name="Raise" />
        </then>
        <none>
          <action name="Execute" command="omarchy-launch-webapp 'https://photos.google.com/'" />
        </none>
      </action>
    </keybind>

    <!-- Compositor control -->
    <keybind key="W-S-x"><action name="Exit" /></keybind>
    <keybind key="C-S-Escape"><action name="Exit" /></keybind>
    <!-- labwc has no Restart action; Reconfigure re-reads all config and theme -->
    <keybind key="C-S-BackSpace"><action name="Reconfigure" /></keybind>
    <keybind key="C-S-R"><action name="Reconfigure" /></keybind>
    <keybind key="W-S-Escape"><action name="Execute" command="xkill" /></keybind>

    <!-- Type the primary selection, then clear it (was: xdotool type "$(xsel -oc)") -->
    <keybind key="W-space">
      <action name="Execute" command="sh -c 'sleep 0.3; sel=$(wl-paste -p -n); wl-copy -pc; wtype &quot;$sel&quot;'" />
    </keybind>

    <!-- Windows whose title starts with @ are hidden, not closed -->
    <keybind key="A-q">
      <action name="If">
        <query title="@*" />
        <then>
          <action name="Iconify" />
        </then>
        <else>
          <action name="Close" />
        </else>
      </action>
    </keybind>
    <keybind key="A-S-q"><action name="Close" /></keybind>
    <keybind key="A-w"><action name="Iconify" /></keybind>
    <keybind key="W-d"><action name="ToggleShowDesktop" /></keybind>

    <!-- Activate Move/Resize -->
    <keybind key="A-r"><action name="Resize" /></keybind>
    <keybind key="A-m"><action name="Move" /></keybind>

    <!-- Menus -->
    <keybind key="S-W-space"><action name="ShowMenu" menu="root-menu" /></keybind>
    <keybind key="C-A-space"><action name="ShowMenu" menu="app-menu" /></keybind>
    <keybind key="A-space"><action name="ShowMenu" menu="client-menu" /></keybind>
  </keyboard>

  <!-- ################################ Mouse Settings ################################ -->
  <mouse>
    <doubleClickTime>400</doubleClickTime>

    <context name="Frame">
      <mousebind button="A-Left" action="Press">
        <action name="Focus" />
        <action name="Raise" />
      </mousebind>
      <mousebind button="W-Left" action="Drag">
        <action name="Move" />
      </mousebind>
      <mousebind button="A-Right" action="Press">
        <action name="Focus" />
        <action name="Raise" />
        <action name="Unshade" />
      </mousebind>
      <mousebind button="A-Right" action="Drag">
        <action name="Resize" />
      </mousebind>
    </context>

    <context name="TitleBar">
      <mousebind button="Left" action="Press">
        <action name="Focus" />
        <action name="Raise" />
      </mousebind>
      <mousebind button="A-Left" action="Press">
        <action name="Focus" />
        <action name="Raise" />
      </mousebind>
      <mousebind button="Right" action="Press">
        <action name="Focus" />
        <action name="Raise" />
        <action name="ShowMenu" menu="client-menu" />
      </mousebind>
      <!-- Openbox: scroll up shades and drops focus, scroll down unshades -->
      <mousebind direction="Up" action="Scroll">
        <action name="Shade" />
        <action name="Unfocus" />
        <action name="Lower" />
      </mousebind>
      <mousebind direction="Down" action="Scroll">
        <action name="Unshade" />
        <action name="Raise" />
      </mousebind>
    </context>

    <context name="Title">
      <!-- labwc un-maximizes on drag by itself (see resistance/unMaximizeThreshold) -->
      <mousebind button="Left" action="Drag">
        <action name="Move" />
      </mousebind>
      <mousebind button="A-Left" action="Drag">
        <action name="Move" />
      </mousebind>
      <mousebind button="Left" action="DoubleClick">
        <action name="ToggleMaximize" direction="both" />
      </mousebind>
    </context>

    <!-- Border covers Top/Bottom/Left/Right and all four corners -->
    <context name="Border">
      <mousebind button="Left" action="Press">
        <action name="Focus" />
        <action name="Raise" />
        <action name="Unshade" />
      </mousebind>
      <mousebind button="Left" action="Drag">
        <action name="Resize" />
      </mousebind>
      <mousebind button="Right" action="Press">
        <action name="Focus" />
        <action name="Raise" />
        <action name="ShowMenu" menu="client-menu" />
      </mousebind>
    </context>

    <context name="Client">
      <mousebind button="A-Left" action="Press">
        <action name="Focus" />
        <action name="Raise" />
      </mousebind>
      <mousebind button="A-Left" action="Drag">
        <action name="Move" />
      </mousebind>
      <mousebind button="Left" action="Press">
        <action name="Focus" />
        <action name="Raise" />
      </mousebind>
      <mousebind button="Right" action="Press">
        <action name="Focus" />
        <action name="Raise" />
      </mousebind>
    </context>

    <context name="Icon">
      <mousebind button="Right" action="Press">
        <action name="Focus" />
        <action name="Raise" />
        <action name="Unshade" />
        <action name="ShowMenu" menu="client-menu" />
      </mousebind>
    </context>

    <context name="AllDesktops">
      <mousebind button="Left" action="Click">
        <action name="ToggleOmnipresent" />
      </mousebind>
    </context>

    <context name="Shade">
      <mousebind button="Left" action="Click">
        <action name="ToggleShade" />
      </mousebind>
    </context>

    <context name="Iconify">
      <mousebind button="Left" action="Click">
        <action name="Iconify" />
      </mousebind>
    </context>

    <context name="Maximize">
      <mousebind button="Left" action="Click">
        <action name="ToggleMaximize" direction="both" />
      </mousebind>
      <mousebind button="Right" action="Click">
        <action name="ToggleMaximize" direction="horizontal" />
      </mousebind>
    </context>

    <context name="Close">
      <mousebind button="Left" action="Click">
        <action name="Close" />
      </mousebind>
    </context>

    <context name="Desktop">
      <mousebind button="Right" action="Press">
        <action name="ShowMenu" menu="root-menu" />
      </mousebind>
      <mousebind button="Middle" action="Press">
        <action name="ShowMenu" menu="client-list-combined-menu" />
      </mousebind>
      <mousebind button="A-Right" action="Press">
        <action name="ShowMenu" menu="client-list-combined-menu" />
      </mousebind>
      <mousebind direction="A-Up" action="Scroll">
        <action name="GoToDesktop" to="left" />
      </mousebind>
      <mousebind direction="A-Down" action="Scroll">
        <action name="GoToDesktop" to="right" />
      </mousebind>
    </context>
  </mouse>

  <!-- ################################ Input Devices ################################ -->
  <libinput>
    <!-- "non-touch" = traditional mice (Logitech Wireless Mouse PID:4022 here).
         Natural scrolling: wheel down moves the content down. -->
    <device category="non-touch">
      <naturalScroll>yes</naturalScroll>
    </device>
  </libinput>

  <!-- ################################ Menu Settings ################################ -->
  <menu>
    <ignoreButtonReleasePeriod>250</ignoreButtonReleasePeriod>
    <showIcons>no</showIcons>
  </menu>

  <!-- ################################ Window Rules ################################ -->
  <!--
    Openbox <applications> -> labwc <windowRules>.
    Dropped: the class="*" rule (its only effect was centring, now done by
    <placement><policy>center</policy>) and the "obconf" rule (openbox-only tool).
  -->
  <windowRules>
    <!-- No titlebar by default, but keep the border (cyan when focused, see
         themerc-override). Per-app rules below can override this. -->
    <windowRule identifier="*">
      <action name="SetDecorations" decorations="border" forceSSD="no" />
    </windowRule>

    <windowRule title="TIMER">
      <skipTaskbar>yes</skipTaskbar>
      <action name="MoveToEdge" direction="right" snapWindows="no" />
      <action name="MoveToEdge" direction="down" snapWindows="no" />
      <action name="ToggleAlwaysOnTop" />
    </windowRule>

    <!-- Openbox asked for 50% x 50%; ResizeTo is pixels-only, so use a region -->
    <windowRule title="Network Connections">
      <action name="SnapToRegion" region="center-half" />
    </windowRule>
  </windowRules>

  <!--
