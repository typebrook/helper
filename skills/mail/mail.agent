#!/bin/bash
# Pipe a raw message from mutt; hand its Message-ID to `pi -p` with the mail skill.
# -n: only print the command, do not run pi
#
# Delivers a flagged "[Claim]" reply, so the issue is marked as taken and mutt
# shows it as soon as the pipe returns. A detached session (setsid -f) then:
#   1. runs pi, logged into ~/.cache/mail-agent/<SESSION>.log
#   2. if pi succeeds, deletes the claim and adds token usage to the agent's reply (usage.py)
#      on failure the claim stays, to show the resume command
set -euo pipefail

SKILL=$HOME/helper/skills/mail
LOGDIR=$HOME/.cache/mail-agent

agent() { ${DRY:-} claude -p "/mail $1" --session-id "$2" --dangerously-skip-permissions --output-format json --model sonnet; }
#agent() { ${DRY:-} pi -p "/skill:mail $1" --skill "$SKILL" --session-id "$2" --mode json --model sonnet; }

# Detached part, re-executed by the part below
if [ "${1:-}" = --run ]; then
  id=$2 session=$3 claim_id=$4
  cd "$SKILL"
  since=$(date +%s) status=0
  result=$(agent "$id" "$session") || status=$?
  echo "$result"
  [ $status -eq 0 ] || exit $status

  # Resolve the claim again: mail client or sync may have renamed it by flags
  if path=$(notmuch search --output files id:"$claim_id"); then
    rm -f "$path"
  fi
  ./usage.py "$id" --since "$since" <<<"$result"
  exit
fi

# Message-ID from stdin (handles folded headers and any capitalization)
id=$(sed -En '/^Message-I[dD]/{p;n;/^ /{p};q}' | tr -d '[<> \n]' | cut -d: -f2)
cat >/dev/null  # drain the rest, so mutt does not get SIGPIPE
[ -n "$id" ] || { echo "mail-agent: no Message-ID" >&2; exit 1; }

session=$(uuidgen)
[ "${1:-}" = -n ] && { DRY=echo agent "$id" "$session"; exit; }

# Claim: flagged reply in the original's Maildir; the flag moves from original to claim
cd "$SKILL"
orig=$(notmuch search --output files  id:"$id")
claim_id=$(date +%s.%N).claim@$(hostname)
mmime -r <<EOF | mdeliver -c -X F "$(dirname "$(dirname "$orig")")" >/dev/null
From: none@$(hostname)
To: $(mhdr -h reply-to "$orig" || mhdr -h from "$orig")
Subject: [Claim] pi --session $session  # on $(hostname)
Date: $(mdate)
Message-ID: <$claim_id>
In-Reply-To: <$id>
References: $(mhdr -h references "$orig" || mhdr -h in-reply-to "$orig" || true) <$id>
Agent-Model: none

EOF
mflag -f "$orig" >/dev/null

log=$LOGDIR/$session.log
mkdir -p "$LOGDIR"
setsid -f "$(realpath "$0")" --run "$id" "$session" "$claim_id" >"$log" 2>&1 </dev/null
