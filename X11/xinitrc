#!/bin/sh
# Started by startx (see profile: auto-start on tty1)

# Run system xinitrc.d scripts (dbus, etc.)
if [ -d /etc/X11/xinit/xinitrc.d ]; then
  for f in /etc/X11/xinit/xinitrc.d/?*.sh; do
    [ -x "$f" ] && . "$f"
  done
  unset f
fi

[ -f ~/.xprofile ] && . ~/.xprofile

exec openbox-session
