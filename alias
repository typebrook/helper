file.size() {
  find $1 -type f -print0 |\
  xargs -0 ls -l |\
  awk '{ n=int(log($5)/log(2));
           if (n<10) n=10;
           size[n]++ }
       END { for (i in size) printf("%d %d\n", 2^i, size[i])
  }' |\
  sort -n |\
  awk 'function human(x) { x[1]/=1024; if (x[1]>=1024) { x[2]++; human(x) }}
  {
    a[1]=$1;
    a[2]=0;
    human(a);
    printf("%3d%s: %6d\n", a[1],substr("kMGTEPYZ",a[2]+1,1),$2)
  }'
}

