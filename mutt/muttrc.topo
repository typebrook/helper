# Identify meself
set my_user = "pham@mail.topo.tw"; setenv my_user "$my_user"
set folder = "imaps://$my_user:993"
set imap_pass = `pass mail/$my_user`
set smtp_url = "smtps://$my_user:465"
set smtp_pass = `pass mail/$my_user`

# user info in mail
set from = "pham@topo.tw"
set realname = "謝晉凡 Hsieh Chin Fan"
set signature = "~/helper/mutt/.signature"
#set pgp_use_gpg_agent=yes
#set crypt_use_gpgme = yes
#set pgp_timeout = 300
#set pgp_sign_as = 6DD8C14A # replace 6DD8C14A with your gpg key id
#set autocrypt = yes

# For contacts
set display_filter = ~/helper/mutt/message_filter.sh
source ~/helper/mutt/alias.topo
source ~/helper/mutt/hooks.topo

## Basic Mailbox
set spoolfile = "+"
set record = "+"
set mbox= "+Archive"
set trash = "+Trash"
#set postponed = "+Drafts"
#set move = yes
set mask="!(tmp|new|cur|dovecot.*|\\..*|maildirfolder)"

# Sidebar
mailboxes   -label 'INBOX' -poll + \
            -poll +Archive\
            -poll -label '[p]ay'        +pay \


# Change mailboxes
macro index,pager   gi      "<change-folder>+<Return>" "Switch to INBOX folder"
macro index,pager   ga      "<change-folder>+Archive<Return>"
macro index,pager   gd      "<change-folder>+Drafts<Return>"
macro index,pager   gs      "<change-folder>+Sent<Return>"
macro index,pager   gb      "<change-folder>+box<Return>"
macro index,pager   gt      "<change-folder>+Trash<Return>"
macro index,pager   gT      "<change-folder>+Trash<Return>"
macro index,pager   gj      "<change-folder>+Junk<Return>"
macro index,pager   gk      "<change-folder>+keep<Return>"
macro index,pager   gp      "<change-folder>+pay<Return>"
