    <keybind key="W-S-w"><action name="Execute" command="uwsm-app -- omawrite" /></keybind>

    <!-- Activity monitor (SUPER+CTRL+T) - btop in a terminal, run-or-raise -->
    <keybind key="W-C-t">
      <action name="ForEach">
        <query identifier="org.omarchy.btop" />
        <then>
          <action name="Focus" />
          <action name="Raise" />
        </then>
        <none>
          <action name="Execute" command="omarchy-launch-tui btop" />
        </none>
      </action>
    </keybind>

    <!-- Music TUI (SUPER+SHIFT+ALT+M) -->
    <keybind key="W-S-A-m">
      <action name="ForEach">
        <query identifier="org.omarchy.cliamp" />
        <then>
          <action name="Focus" />
          <action name="Raise" />
        </then>
        <none>
          <action name="Execute" command="omarchy-launch-tui cliamp" />
        </none>
      </action>
